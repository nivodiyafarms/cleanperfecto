# Supabase (service-role client — see src/lib/supabase/admin.ts)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend (transactional email — see src/lib/email/resend.ts)
RESEND_API_KEY=
# Comma-separated list of admin recipients for quote/booking notifications.
QUOTE_NOTIFICATION_EMAILS=

# Canonical site origin (no trailing slash), used to build Stripe Checkout
# success_url/cancel_url. Falls back to http://localhost:3000 in
# development if unset — see src/lib/booking/site-url.ts.
NEXT_PUBLIC_SITE_URL=

# Notifications V1 (see src/app/api/cron/dispatch-notifications/route.ts)
# Shared secret Supabase Cron (pg_net) sends as the x-cron-secret header.
# Never commit a real value. Generate a long random string per environment.
CRON_DISPATCH_SECRET=
# Set to "fake" to use in-memory senders that perform no real network call
# (used for disposable-Supabase validation and local testing only). Any
# other value/unset uses the real Resend-backed email sender. SMS always
# uses the not-yet-supported stand-in regardless of this value — no Twilio
# integration exists in this milestone, so a real SMS can never be sent.
NOTIFICATION_DISPATCH_MODE=

# Stripe (Booking + Payment — see src/lib/booking/stripe/client.ts)
# Use TEST MODE keys only during development. Never commit real values —
# this file is a template; the actual .env.local is gitignored.
# Prefer a restricted API key (rk_...) scoped to only what booking/payment
# code needs (Checkout Sessions, Customers, Webhook Endpoints) over a broad
# secret key (sk_...) — see https://docs.stripe.com/keys/restricted-api-keys.
STRIPE_SECRET_KEY=
# From the Stripe Dashboard webhook endpoint (test mode) or `stripe listen`
# during local development.
STRIPE_WEBHOOK_SECRET=
