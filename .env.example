# ============================================================================
# Business-runtime safety (Phase 2 — see src/lib/config/runtime-env.ts)
# These three gate every payment/tax code path in the app. Read only through
# that module — never interpreted ad hoc elsewhere. Absent values fail
# CLOSED for money (PAYMENT_MODE/TAX_MODE default to "disabled"; APP_ENV
# defaults to "development", which itself forbids stripe_enabled). A
# present-but-unrecognized value throws rather than guessing.
# ============================================================================

# One of: development | test | operational_beta | production
# Authoritative for business-runtime safety — never inferred from NODE_ENV.
APP_ENV=development

# One of: disabled | external_only | stripe_sandbox | stripe_enabled
#   disabled       - emergency kill switch: no Stripe setup/charge, no
#                    external-receipt recording. Existing read-only payment
#                    views stay visible.
#   external_only  - no Stripe card flows; genuine Zelle/Cash recording via
#                    the existing frozen/system-derived amount flow is
#                    allowed. Stripe Tax may still run if TAX_MODE=stripe_tax.
#   stripe_sandbox - Stripe TEST keys/events only. Only allowed when
#                    APP_ENV is development or test.
#   stripe_enabled - Stripe LIVE keys/events only. Only allowed when
#                    APP_ENV is operational_beta or production.
# See PAYMENT_MODE_COMPATIBILITY in src/lib/config/runtime-env.ts for the
# full matrix; an invalid combination throws a configuration error rather
# than silently picking one side.
PAYMENT_MODE=disabled

# One of: disabled | stripe_tax
# Independent of PAYMENT_MODE — an external (Zelle/Cash) settlement can
# still require authoritative Stripe Tax calculation/reconciliation. No
# local tax engine exists or should ever be added; "disabled" means no
# Stripe Tax calculation is initiated at all, not a substitute flat rate.
TAX_MODE=disabled

# Supabase (service-role client — see src/lib/supabase/admin.ts)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key for the browser-side Supabase client (auth cookie
# exchange, etc.) — see src/lib/supabase/env.ts. Safe to expose by design.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend (transactional email — see src/lib/email/resend.ts)
RESEND_API_KEY=
# Comma-separated list of admin recipients for quote/booking notifications.
QUOTE_NOTIFICATION_EMAILS=

# Canonical site origin (no trailing slash), used to build Stripe Checkout
# success_url/cancel_url. Falls back to http://localhost:3000 in
# development if unset — see src/lib/booking/site-url.ts.
NEXT_PUBLIC_SITE_URL=

# Notifications V1 (see src/app/api/cron/dispatch-notifications/route.ts)
# Shared secret Supabase Cron (pg_net) sends as the x-cron-secret header.
# Never commit a real value. Generate a long random string per environment.
CRON_DISPATCH_SECRET=
# Set to "fake" to use in-memory senders that perform no real network call
# (used for disposable-Supabase validation and local testing only). Any
# other value/unset uses the real Resend-backed email sender. SMS always
# uses the not-yet-supported stand-in regardless of this value — no Twilio
# integration exists in this milestone, so a real SMS can never be sent.
NOTIFICATION_DISPATCH_MODE=

# Webhook claim recovery (see src/app/api/cron/retry-stuck-webhook-events/route.ts)
# Shared secret Supabase Cron (pg_net) sends as the x-cron-secret header.
# Never commit a real value, and never reuse CRON_DISPATCH_SECRET — a
# distinct secret per cron job, same convention as Notifications V1.
CRON_WEBHOOK_RETRY_SECRET=

# Consent + Review Automation V1 (see src/lib/notifications/google-review-url.ts)
# The destination for review_request notifications. Never hardcode a
# temporary Google Maps/share URL in code — configure it here per
# environment. Missing/blank causes review_request enqueue and dispatch to
# fail safely (never sends a broken/missing link). For local/disposable
# testing, use a harmless placeholder (e.g. https://example.com/leave-a-review),
# never a real Google URL until production activation.
GOOGLE_REVIEW_URL=

# Stripe (Booking + Payment — see src/lib/booking/stripe/client.ts)
# Only read/used when PAYMENT_MODE is stripe_sandbox or stripe_enabled —
# see src/lib/config/payment-capabilities.ts and stripe-key-mode.ts, which
# enforce that this key's test/live mode agrees with PAYMENT_MODE and with
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY below. Never commit a real value —
# this file is a template; the actual .env.local is gitignored.
# Prefer a restricted API key (rk_test_.../rk_live_...) scoped to only what
# booking/payment code needs (Checkout Sessions, Customers, Webhook
# Endpoints, Tax) over a broad secret key (sk_test_.../sk_live_...) — see
# https://docs.stripe.com/keys/restricted-api-keys. Both prefix families
# are recognized as test/live mode identically.
STRIPE_SECRET_KEY=
# From the Stripe Dashboard webhook endpoint (test or live mode, matching
# PAYMENT_MODE) or `stripe listen` during local development. A webhook
# secret alone never reveals test/live mode — the verified event's own
# `livemode` field is checked against PAYMENT_MODE at processing time (see
# src/lib/booking/webhook/webhook-fulfillment-guard.ts).
STRIPE_WEBHOOK_SECRET=

# Pay-Per-Cleaning + Tipping V1 (see @stripe/stripe-js usage in
# src/app/my/(protected)/payments/) — the publishable key (pk_test_.../
# pk_live_...), safe to expose to the browser by design. Used only to
# confirm an already-server-created PaymentIntent client-side via
# confirmCardPayment; no card entry/Elements form is built with it. Must be
# the same test/live mode as STRIPE_SECRET_KEY above — a mismatch is a
# configuration error, not a fallback to whichever key wins.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
